# Copy to .env.local (gitignored) to override a value for yourself.
#
# You should not need VITE_API_BASE_URL locally: .env.development sets it to /api, which
# the dev server proxies to the backend (server.proxy in vite.config.ts). Set it here only
# to point the browser at some other backend.
VITE_API_BASE_URL=/api
VITE_PUBLIC_SITE_URL=https://app.upmovies.localhost
VITE_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
# Cloudflare Turnstile site key for the signup widget. Unset, src/env.ts falls back to
# Cloudflare's always-passes test key, which is what you want locally -- the backend's
# TURNSTILE_SECRET has a matching dev bypass. A site key is public; the secret is the
# backend's and is never set here.
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# VITE_SENTRY_DSN=<your-upcoming-movies-frontend-Bugsink-DSN>
#
# Production (set in Cloudflare Workers Builds -> Settings -> build environment variables):
#   VITE_API_BASE_URL=https://api.backlotter.com
#   VITE_PUBLIC_SITE_URL=https://backlotter.com   # must match backend PUBLIC_BASE_URL (sitemap proxy)
#   VITE_SENTRY_DSN=<upcoming-movies-frontend Bugsink DSN>   # activates the browser Sentry SDK
#   VITE_TURNSTILE_SITE_KEY=<backlotter Turnstile site key>   # must pair with the API's TURNSTILE_SECRET
#   SENTRY_URL=https://bugsink.neuroticsasquat.ch/   # where source maps upload (@sentry/vite-plugin)
#   SENTRY_AUTH_TOKEN=<Bugsink upload token>      # build SECRET; enables the upload. Unset -> no maps, warning
#   SENTRY_ORG / SENTRY_PROJECT                   # optional overrides (default bugsinkhasnoorgs / upcoming-movies-frontend)
# None of the SENTRY_* build vars is VITE_-prefixed, so none reaches the client bundle. The release is
# the commit SHA: VITE_GIT_SHA, else Workers Builds' WORKERS_CI_COMMIT_SHA (set automatically).
# The Worker's own DSN is a Wrangler secret, not a build var: `wrangler secret put SENTRY_DSN`.
# The SSR-runtime API_BASE_URL is committed in wrangler.jsonc (vars); local dev overrides it via .dev.vars.

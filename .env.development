# Loaded by Vite in dev only (mode=development). Vitest runs in mode=test and does not
# read this file, so the fallbacks in src/env.ts still stand in tests.
#
# Relative on purpose: the browser talks to the dev server's own origin and Vite proxies
# /api to the backend (see server.proxy in vite.config.ts). That keeps dev same-origin, so
# it works however the workspace is reached -- localhost:5173 or the HTTPS proxy -- and the
# session cookie and CSRF header behave the way they do in prod.
VITE_API_BASE_URL=/api
